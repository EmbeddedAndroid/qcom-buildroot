From 69da840e688a6df5462556c5033a8df67b526dd5 Mon Sep 17 00:00:00 2001
From: Tyler Baker <tyler.baker@oss.qualcomm.com>
Date: Fri, 2 Oct 2026 11:22:50 -0400
Subject: [PATCH 2/4] arm64: dts: qcom: pm4125: label the RTC node

Boards need to add properties to the RTC node, such as where the RTC
offset is stored. Give it a label.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/pm4125.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/pm4125.dtsi b/arch/arm64/boot/dts/qcom/pm4125.dtsi
index cf8c822e8..16533e099 100644
--- a/arch/arm64/boot/dts/qcom/pm4125.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm4125.dtsi
@@ -66,7 +66,7 @@ pm4125_typec: typec@1500 {
 			status = "disabled";
 		};
 
-		rtc@6000 {
+		pm4125_rtc: rtc@6000 {
 			compatible = "qcom,pm8941-rtc";
 			reg = <0x6000>, <0x6100>;
 			reg-names = "rtc", "alarm";
-- 
2.47.3

