<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <include name="manifests/common.xml" />
  <remote name="qcl"   fetch="https://github.com/qualcomm-linux" />
  <remote name="tfa"   fetch="https://review.trustedfirmware.org/TF-A" />
  <remote name="optee" fetch="https://github.com/OP-TEE" />
  <remote name="ldts"  fetch="https://github.com/ldts" />
  <remote name="ea"    fetch="https://github.com/EmbeddedAndroid" />

  <!-- Every project is pinned to a commit; upstream names the branch it
       was taken from. Move a pin only with the LAVA proof of the new set. -->
  <project path="build" remote="ea" name="qcom-buildroot.git" revision="8c957ef956893c0b47b4f56435681f7ca648f5d2" upstream="features/lemans/security/dtpm-drtm">
    <linkfile src="lemans.mk" dest="build/Makefile" />
  </project>

  <remove-project                      name="linaro-swg/linux.git" />
  <remove-project                      name="OP-TEE/optee_os.git" />

  <!-- The DRTM trees, from features/lemans/drtm of each project. -->
  <project path="linux"                remote="ea"    name="linux.git"                revision="88b52b9a79bbe304003a73a70f367abf4c420a02" upstream="features/lemans/drtm" clone-depth="10" sync-tags="false"/>
  <project path="arm-trusted-firmware" remote="ea"    name="arm-trusted-firmware.git" revision="6f3827d76d0dfba33703130660df491ad055c838" upstream="features/lemans/drtm"/>
  <project path="optee_os"             remote="ea"    name="optee_os.git"             revision="86156c9f9a534052ed23eab2f723556cfe25f110" upstream="features/lemans/drtm"/>
  <project path="xen"                  remote="ea"    name="xen.git"                  revision="6f4c26555bdbf8b59ba5989fb864dd2e696f6df4" upstream="features/lemans/drtm"/>
  <!-- Not built: a checkout of the test definitions for reference. LAVA
       fetches LAVA_TEST_REPO at LAVA_TEST_BRANCH at run time, not this pin. -->
  <project path="test-definitions"     remote="ea"    name="test-definitions.git"     revision="b14bf67bdd8231b8a253c8247a98ae78f8f1d2ec" upstream="features/lemans/drtm"/>
  <project path="u-boot"               remote="ea"    name="u-boot.git"               revision="bcb173bae4a4f8c05be44985f4f7733c25033d3a" upstream="features/lemans/drtm"/>

  <!-- common.xml projects, pinned here so kodiak.xml keeps its defaults.
       xtest from 962b322 (regression 1048) needs the stack protector PTA
       commands of a newer optee_os than features/lemans/drtm. -->
  <extend-project name="OP-TEE/optee_test.git"         revision="e92a1880e74b45c5ff31b8d5b917ab2278f06760" upstream="master"/>
  <extend-project name="OP-TEE/optee_client.git"       revision="9f4414f62dfc5692fd39f760515ce2d344d07b6d" upstream="master"/>
  <extend-project name="OP-TEE/optee_ftpm.git"         revision="f09f4cdad21028289d4e8fc573893b75f7228dc7" upstream="master"/>
  <extend-project name="linaro-swg/optee_examples.git" revision="71e8f3f320eef46a9369700bf30b91d67427d535" upstream="master"/>
  <extend-project name="buildroot/buildroot.git"       revision="fcde5363aa35220a1f201159a05de652ec6f811f" upstream="refs/tags/2025.05"/>
</manifest>
