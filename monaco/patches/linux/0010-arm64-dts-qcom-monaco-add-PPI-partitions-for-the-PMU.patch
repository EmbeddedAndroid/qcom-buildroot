From b50531f9ffe4536f5864fd4de9494d34812c0cfa Mon Sep 17 00:00:00 2001
From: Tyler Baker <tyler.baker@oss.qualcomm.com>
Date: Sat, 3 Oct 2026 12:07:09 -0400
Subject: [PATCH] arm64: dts: qcom: monaco: add PPI partitions for the PMUs

The Cortex-A55 and Cortex-A78 PMU nodes both use PPI 7 without a
partition, so each PMU driver claims all eight CPUs and only one of them
gets the per-CPU interrupt. Overflow interrupts are lost. On the Arduino
VENTUNO Q, a cycles sampling event with one overflow per 10^6 cycles,
run for 2 s on CPU 0:

  /sys/bus/event_source/devices/armv8_cortex_a55 cpus=0-7
  /sys/bus/event_source/devices/armv8_cortex_a78 cpus=0-7
  cpu 0: 3016444437 cycles, 3016 overflows expected

takes 6 PMU interrupts on CPU 0, and five of the kvm-unit-tests PMU
tests fail on overflow (pmu-overflow-interrupt among them). Counting
works without the interrupt, which hid this since the nodes were added.

Add a PPI partition per cluster, cpu0-cpu3 (Cortex-A78C) and cpu4-cpu7
(Cortex-A55), and pass it in the fourth cell of each PMU interrupt.

Fixes: 09d8a3ef91f6 ("arm64: dts: qcom: qcs8300: Add PMU support for QCS8300")
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/monaco.dtsi | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/monaco.dtsi b/arch/arm64/boot/dts/qcom/monaco.dtsi
index bbbc1b1327c8..f87ce1ba6464 100644
--- a/arch/arm64/boot/dts/qcom/monaco.dtsi
+++ b/arch/arm64/boot/dts/qcom/monaco.dtsi
@@ -646,12 +646,12 @@
 
 	pmu-a55 {
 		compatible = "arm,cortex-a55-pmu";
-		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW 0>;
+		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW &ppi_cluster1>;
 	};
 
 	pmu-a78 {
 		compatible = "arm,cortex-a78-pmu";
-		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW 0>;
+		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW &ppi_cluster0>;
 	};
 
 	psci {
@@ -7398,6 +7398,16 @@
 			#redistributor-regions = <1>;
 			redistributor-stride = <0x0 0x20000>;
 			#address-cells = <0>;
+
+			ppi-partitions {
+				ppi_cluster0: interrupt-partition-0 {
+					affinity = <&cpu0 &cpu1 &cpu2 &cpu3>;
+				};
+
+				ppi_cluster1: interrupt-partition-1 {
+					affinity = <&cpu4 &cpu5 &cpu6 &cpu7>;
+				};
+			};
 		};
 
 		watchdog@17c10000 {
-- 
