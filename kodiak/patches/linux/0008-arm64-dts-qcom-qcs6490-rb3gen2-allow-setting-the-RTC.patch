From 1e951cc9d78a0b8838cdacc057cfaa2082227d34 Mon Sep 17 00:00:00 2001
From: Tyler Baker <tyler.baker@oss.qualcomm.com>
Date: Fri, 2 Oct 2026 11:22:51 -0400
Subject: [PATCH 8/9] arm64: dts: qcom: qcs6490-rb3gen2: allow setting the RTC

The application processor can write the PMK8350 RTC counter on the
RB3 Gen 2 (an RTC_RW write from the boot firmware succeeds and reads
back), as on the QCS6490 Rubik Pi 3, but without "allow-set-time" the
driver refuses to set the time. Allow it.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Tyler Baker <tyler.baker@oss.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/qcs6490-rb3gen2.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-rb3gen2.dts b/arch/arm64/boot/dts/qcom/qcs6490-rb3gen2.dts
index 8b9fb6d94665..ee6dd8771c09 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-rb3gen2.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-rb3gen2.dts
@@ -1045,6 +1045,8 @@ led@3 {
 };
 
 &pmk8350_rtc {
+	allow-set-time;
+
 	status = "okay";
 };
 
-- 
2.47.3

