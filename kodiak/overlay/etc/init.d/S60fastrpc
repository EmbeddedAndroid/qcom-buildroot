#!/bin/sh
# FastRPC daemons for the Kodiak DSPs, as the meta-qcom fastrpc units run
# them: cdsprpcd, adsprpcd and adsprpcd audiopd. The RB3 Gen 2 starts no
# CDSP1, SDSP or GPDSP.
#
# A /dev/fastrpc-* node appears only once its DSP has booted and opened the
# GLINK fastrpc channel, well after init runs, so each daemon waits for its
# node, up to FASTRPC_NODE_TIMEOUT seconds from the start, in the background.

FASTRPC_NODE_TIMEOUT=${FASTRPC_NODE_TIMEOUT:-60}
FASTRPC_PIDFILE=${FASTRPC_PIDFILE:-/var/run/fastrpc-start.pid}

# wait_start <node> <daemon> [args...]: start the daemon once <node> or
# <node>-secure exists.
wait_start() {
	node=$1
	shift
	while [ ! -e $node ] && [ ! -e $node-secure ]; do
		if [ $(date +%s) -ge $deadline ]; then
			echo "fastrpc: no $node after ${FASTRPC_NODE_TIMEOUT}s, not starting $*"
			return
		fi
		sleep 1
	done
	echo "Starting $*"
	"$@" &
}

start_all() {
	deadline=$(($(date +%s) + FASTRPC_NODE_TIMEOUT))
	wait_start /dev/fastrpc-cdsp cdsprpcd
	wait_start /dev/fastrpc-adsp adsprpcd
	wait_start /dev/fastrpc-adsp adsprpcd audiopd
}

case "$1" in
start)
	start_all &
	echo $! >$FASTRPC_PIDFILE
	;;
stop)
	[ -f $FASTRPC_PIDFILE ] && kill $(cat $FASTRPC_PIDFILE) 2>/dev/null
	rm -f $FASTRPC_PIDFILE
	kill $(pidof adsprpcd cdsprpcd) 2>/dev/null
	;;
restart)
	"$0" stop
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
